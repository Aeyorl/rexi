# Network Mode: 'testnet' (default) or 'mainnet'
NETWORK_MODE=testnet

# --- Testnet Configuration (Robinhood Chain Testnet, Chain ID 46630) ---
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_FALLBACK_RPC=
RH_CHAIN_ID=46630
# Optional override for testnet launchpad contract address:
# REXI_LAUNCHPAD_TESTNET=0xabaAd57e9Dbb401356c0b03d724c2714056e7dA0
REXI_TESTNET_START_BLOCK=120000000

# --- Mainnet Configuration (Robinhood Chain Mainnet, Chain ID 4663) ---
RH_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/HMKXQ2KwDrFO0nwFthZm0
RH_MAINNET_FALLBACK_RPC=https://rpc.chain.robinhood.com
RH_MAINNET_CHAIN_ID=4663
# Canonical deployed Launchpad contract address on Robinhood Chain Mainnet:
REXI_LAUNCHPAD_MAINNET=
# Block number where the launchpad contract was deployed on Mainnet (prevents scanning from block 0):
REXI_MAINNET_START_BLOCK=0

# --- Treasuries receiving distribution fee splits ---
REXI_PROTOCOL_TREASURY=0xa5e7d6C189b37D9293908E0A28Da4D65d65a7f7A
REXI_DESKS_TREASURY=0x913B8D346625736958664C77b0C8Efd3DA2a7bA2
REXI_BUYBACK_TREASURY=0x8cA71B70C91BD8250073dfDD323b9219Bce6A165

# --- Indexer & Performance ---
INDEXER_POLL_INTERVAL_MS=10000
INDEXER_CHUNK_SIZE=5000

# Set locally only for deploy/admin scripts. Never commit private keys!
PRIVATE_KEY=
